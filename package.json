{
  "name": "@gonzih/hd-bodygraph",
  "version": "1.0.2",
  "description": "Human Design bodygraph SVG renderer with autonomous visual refinement loop",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --external react",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch --external react",
    "render-png": "node scripts/render-png.js",
    "compare": "node scripts/compare.js",
    "refine": "bash scripts/refine-loop.sh",
    "apply-fixes": "node scripts/apply-fixes.js",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "human-design",
    "bodygraph",
    "svg",
    "react"
  ],
  "author": "Maksim Soltan",
  "license": "MIT",
  "peerDependencies": {
    "react": ">=17.0.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "0.52.0",
    "@types/react": "18.3.23",
    "puppeteer": "22.15.0",
    "tsup": "8.5.0",
    "typescript": "5.8.3"
  },
  "dependencies": {
    "react": "18.3.1"
  }
}
